{
	"emulators": {
		"firestore": {
			"port": 8080
		},
		"hosting": {
			"port": 3000
		},
		"storage": {
			"port": 9199
		},
		"ui": {
			"enabled": true
		},
		"singleProjectMode": true
	},
	"hosting": {
		"public": "build",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"frameworksBackend": {
			"region": "europe-west1"
		},
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			}
		],
		"site": "your-firebase-site"
	}
}
