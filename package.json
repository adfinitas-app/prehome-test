{
	"name": "ph",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --config vite.config.ts",
		"build": "npm run iframe && vite build --config vite.config.ts",
		"preview": "npm run build && vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"iframe": "svelte-kit sync && vite build --config vite.config.iframe.ts",
		"cleanup": "sh ./scripts/cleanup.sh",
		"setup": "rm -rf node_modules package-lock.json || echo 'Could not delete packages'; npm i"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@iconify/svelte": "^5.0.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/postcss": "^4.1.17",
		"@tailwindcss/vite": "^4.0.0",
		"autoprefixer": "^10.4.22",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"glob": "^13.0.0",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"prettier": "^3.7.3",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sharp": "^0.34.5",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svgo": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.1.5",
		"vite-plugin-css-injected-by-js": "^3.5.2",
		"vite-plugin-image-optimizer": "^2.0.3"
	}
}
